pipeline {
    agent { label "${params.AGENT_LABEL}" }

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    parameters {
        string(name: 'AGENT_LABEL', defaultValue: 'ansible-agent', description: '공통 Jenkins Agent의 이름 또는 Label')
        string(name: 'SSH_CREDENTIALS_ID', defaultValue: 'soyeon-app-server-ssh', description: 'SSH Username with private key 타입의 Jenkins Credential ID')
        string(name: 'DOCKERHUB_NAMESPACE', defaultValue: 'wosyh18', description: '공개 Docker Hub 저장소의 계정명 또는 namespace')
        string(name: 'DOCKERHUB_CREDENTIALS_ID', defaultValue: 'soyeon-dockerhub', description: 'Docker Hub Username with password 타입 Credential ID (password는 Access Token)')
    }

    environment {
        WORK_DIR = 'practice/soyeon'
        APP_NAME = 'soyeon-app'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    def namespace = (params.DOCKERHUB_NAMESPACE ?: '').trim().toLowerCase()
                    if (!namespace.matches('[a-z0-9][a-z0-9_-]*')) {
                        error('DOCKERHUB_NAMESPACE에 Docker Hub 계정명 또는 namespace를 입력하세요.')
                    }
                    env.GIT_REVISION = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()
                    env.RELEASE_ID = "build-${env.BUILD_NUMBER}"
                    env.IMAGE_TAG = "${env.RELEASE_ID}-${env.GIT_REVISION}"
                    env.IMAGE_REPO = "${namespace}/cc-practice"
                }
            }
        }

        stage('Test') {
            steps {
                dir(env.WORK_DIR) {
                    sh 'docker build --target test --tag "$APP_NAME:test-$BUILD_NUMBER" .'
                }
            }
        }

        stage('Build Image') {
            steps {
                dir(env.WORK_DIR) {
                    sh 'docker build --target runtime --tag "$IMAGE_REPO:$IMAGE_TAG" .'
                }
            }
        }

        stage('Smoke Test') {
            environment {
                SMOKE_CONTAINER = "soyeon-app-smoke-${BUILD_NUMBER}"
            }
            steps {
                sh '''
                    docker rm --force "$SMOKE_CONTAINER" >/dev/null 2>&1 || true
                    docker run --detach --name "$SMOKE_CONTAINER" \
                      --env APP_VERSION="$BUILD_NUMBER" \
                      --env RELEASE_ID="$RELEASE_ID" \
                      --env GIT_REVISION="$GIT_REVISION" \
                      "$IMAGE_REPO:$IMAGE_TAG"

                    healthy=0
                    for attempt in $(seq 1 20); do
                      if docker exec "$SMOKE_CONTAINER" python -c \
                        "import json, urllib.request; data=json.load(urllib.request.urlopen('http://127.0.0.1:8000/health')); assert data['status'] == 'ok'; assert data['version'] == '$BUILD_NUMBER'"; then
                        healthy=1
                        break
                      fi
                      sleep 1
                    done

                    if [ "$healthy" -ne 1 ]; then
                      docker logs "$SMOKE_CONTAINER"
                      exit 1
                    fi
                '''
            }
            post {
                always {
                    sh 'docker rm --force "$SMOKE_CONTAINER" >/dev/null 2>&1 || true'
                }
            }
        }

        stage('Push Image to Docker Hub') {
            steps {
                script {
                    def dockerConfig = "${env.WORKSPACE}/.docker-auth-${env.BUILD_NUMBER}"
                    withEnv(["DOCKER_CONFIG=${dockerConfig}"]) {
                        withCredentials([
                            usernamePassword(
                                credentialsId: params.DOCKERHUB_CREDENTIALS_ID,
                                usernameVariable: 'DOCKER_USER',
                                passwordVariable: 'DOCKER_TOKEN'
                            )
                        ]) {
                            try {
                                sh '''
                                    set +x
                                    umask 077
                                    mkdir -p "$DOCKER_CONFIG"
                                    printf '%s' "$DOCKER_TOKEN" | docker login --username "$DOCKER_USER" --password-stdin
                                '''
                                def pushOutput = sh(
                                    script: 'docker push "$IMAGE_REPO:$IMAGE_TAG"',
                                    returnStdout: true
                                )
                                def digestLine = pushOutput.readLines().find {
                                    it.contains('digest: sha256:')
                                }
                                if (!digestLine) {
                                    error('Docker Hub push 결과에서 이미지 digest를 찾지 못했습니다.')
                                }
                                def pushedDigest = digestLine.split('digest: ')[1].split(' ')[0]
                                if (!pushedDigest.matches('sha256:[0-9a-f]{64}')) {
                                    error('Docker Hub push 결과의 이미지 digest 형식이 올바르지 않습니다.')
                                }
                                env.IMAGE_REF = "${env.IMAGE_REPO}@${pushedDigest}"
                                echo "Published ${env.IMAGE_REF}"
                            } finally {
                                sh '''
                                    docker logout >/dev/null 2>&1 || true
                                    rm -f "$DOCKER_CONFIG/config.json"
                                    rmdir "$DOCKER_CONFIG" 2>/dev/null || true
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy App + Nginx') {
            steps {
                dir("${env.WORK_DIR}/ansible") {
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: params.SSH_CREDENTIALS_ID,
                            keyFileVariable: 'SSH_KEY',
                            usernameVariable: 'SSH_USER'
                        )
                    ]) {
                        sh '''
                            ANSIBLE_HOST_KEY_CHECKING=False ansible-playbook \
                              --inventory inventory/hosts.ini \
                              --user "$SSH_USER" \
                              --private-key "$SSH_KEY" \
                              playbooks/deploy.yml \
                              --extra-vars "image_ref=$IMAGE_REF app_version=$BUILD_NUMBER release_id=$RELEASE_ID git_revision=$GIT_REVISION"
                        '''
                    }
                }
            }
        }

        stage('Verify Nginx') {
            steps {
                sh '"$WORK_DIR/scripts/verify.sh" http://1.201.116.156:18002'
            }
        }
    }

    post {
        cleanup {
            sh '''
                docker image rm "$APP_NAME:test-$BUILD_NUMBER" >/dev/null 2>&1 || true
                if [ -n "${IMAGE_REPO:-}" ] && [ -n "${IMAGE_TAG:-}" ]; then
                    docker image rm "$IMAGE_REPO:$IMAGE_TAG" >/dev/null 2>&1 || true
                fi
            '''
        }
    }
}
