pipeline {
    agent { label 'ansible-agent' }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        PROJECT_DIR = 'practice/dongwook'
        DOCKERHUB_REPOSITORY = 'dongwook-app'
    }

    stages {
        stage('CI') {
            stages {
                // CI: 소스 확인, Python 테스트, 이미지 빌드와 실행 검증
                stage('Checkout') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            // Remove metadata left by an interrupted build before archiving anything.
                            sh '''
                                mkdir -p .artifacts
                                rm -f .artifacts/deploy-vars.json .artifacts/image-inspect.json
                                rm -rf .artifacts/availability
                            '''
                        }
                        checkout scm
                        script {
                            env.GIT_REVISION = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                            env.APP_VERSION = "git-${env.GIT_REVISION.take(12)}"
                            env.RELEASE_ID = "${env.APP_VERSION}-${env.BUILD_NUMBER}"
                            // Registry credentials are bound only during the CD stages.
                            env.IMAGE_TAG = "dongwook-app-ci:${env.RELEASE_ID}-${env.EXECUTOR_NUMBER}"
                            currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.APP_VERSION}"
                        }
                    }
                }

                stage('Python Test') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            sh '''
                                set -eu
                                python3 -m venv .venv
                                .venv/bin/python -m pip install --disable-pip-version-check \
                                    -r app/requirements.txt
                                (cd app && ../.venv/bin/python -m unittest discover -s tests -v)
                                .venv/bin/python -m unittest discover -s scripts/tests -v
                            '''
                        }
                    }
                }

                stage('Validate Ansible') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            sh '''
                                export ANSIBLE_CONFIG="$PWD/ansible/ansible.cfg"
                                ansible-playbook -i ansible/inventory/hosts.yml \
                                    ansible/playbooks/deploy.yml --syntax-check
                            '''
                        }
                    }
                }

                stage('Build Image') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            sh '''
                                docker build \
                                    --build-arg "APP_VERSION=$APP_VERSION" \
                                    --build-arg "RELEASE_ID=$RELEASE_ID" \
                                    --build-arg "GIT_REVISION=$GIT_REVISION" \
                                    -t "$IMAGE_TAG" app
                            '''
                        }
                    }
                }

                stage('Test Image') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            // 실제 배포할 이미지를 실행하고, 호스트 포트 없이 HTTP 응답을 검사한다.
                            sh 'sh scripts/test-image.sh'
                        }
                    }
                }
            }
        }

        stage('CD') {
            stages {
                // CD: Job의 SCM 브랜치에서 검증한 digest를 승인 후 비활성 슬롯에 배포
                stage('Push Image') {
                    steps {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'dockerhub-credentials',
                                usernameVariable: 'DOCKERHUB_USERNAME',
                                passwordVariable: 'DOCKERHUB_TOKEN'
                            )
                        ]) {
                            script {
                                if (!(env.DOCKERHUB_USERNAME ==~ /[a-z0-9][a-z0-9_-]*/)) {
                                    error('dockerhub-credentials의 Username에는 Docker Hub ID를 입력하세요.')
                                }
                                env.IMAGE_REPOSITORY = "${env.DOCKERHUB_USERNAME}/${env.DOCKERHUB_REPOSITORY}"
                                env.PUBLISHED_IMAGE_TAG = "${env.IMAGE_REPOSITORY}:${env.RELEASE_ID}"
                            }
                            dir(env.PROJECT_DIR) {
                                sh '''
                                    set -eu
                                    set +x
                                    umask 077
                                    export DOCKER_CONFIG="$PWD/.artifacts/docker-config"
                                    mkdir -p "$DOCKER_CONFIG"
                                    trap 'rm -rf "$DOCKER_CONFIG"' EXIT
                                    printf '%s' "$DOCKERHUB_TOKEN" | docker login \
                                        --username "$DOCKERHUB_USERNAME" --password-stdin
                                    docker tag "$IMAGE_TAG" "$PUBLISHED_IMAGE_TAG"
                                    docker push "$PUBLISHED_IMAGE_TAG"
                                    docker image inspect "$PUBLISHED_IMAGE_TAG" \
                                        > .artifacts/image-inspect.json
                                    python3 scripts/write-deploy-vars.py
                                '''
                            }
                        }
                    }
                }

                stage('Approve Production') {
                    steps {
                        dir(env.PROJECT_DIR) {
                            archiveArtifacts artifacts: '.artifacts/deploy-vars.json', fingerprint: true
                        }
                        timeout(time: 15, unit: 'MINUTES') {
                            input message: "운영 배포: ${env.RELEASE_ID}. Artifact의 이미지 digest를 확인하세요.",
                            ok: '블루그린 배포'
                        }
                    }
                }

                stage('Deploy Blue Green') {
                    steps {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'dockerhub-credentials',
                                usernameVariable: 'DOCKERHUB_USERNAME',
                                passwordVariable: 'DOCKERHUB_TOKEN'
                            )
                        ]) {
                            dir(env.PROJECT_DIR) {
                                sh '''
                                    set -eu
                                    export ANSIBLE_CONFIG="$PWD/ansible/ansible.cfg"
                                    # Agent 실행 계정의 SSH 키, SSH 설정, known_hosts를 사용한다.
                                    ansible-inventory -i ansible/inventory/hosts.yml --graph
                                    ansible-playbook -i ansible/inventory/hosts.yml \
                                        ansible/playbooks/deploy.yml --list-hosts
                                    # Sample HTTP continuously before, during and after the deployment.
                                    python3 scripts/monitor_deployment.py \
                                        --expected-file .artifacts/deploy-vars.json \
                                        --output-dir .artifacts/availability \
                                        -- ansible-playbook -i ansible/inventory/hosts.yml \
                                            ansible/playbooks/deploy.yml \
                                            --extra-vars @.artifacts/deploy-vars.json
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            dir(env.PROJECT_DIR) {
                archiveArtifacts(
                    artifacts: '.artifacts/deploy-vars.json,.artifacts/availability/*.json,.artifacts/availability/*.jsonl',
                    allowEmptyArchive: true
                )

                // 현재 Workspace의 임시 인증 파일 및 이번 빌드의 리소스만 정리한다.
                sh '''
                    set +x
                    rm -rf .artifacts/docker-config
                    if [ -s .artifacts/test-container ]; then
                        docker rm -f "$(cat .artifacts/test-container)" >/dev/null 2>&1 || true
                    fi
                    rm -f .artifacts/test-container .artifacts/image-inspect.json .artifacts/deploy-vars.json
                    if [ -n "${PUBLISHED_IMAGE_TAG:-}" ]; then docker image rm "$PUBLISHED_IMAGE_TAG" || true; fi
                    if [ -n "${IMAGE_TAG:-}" ]; then docker image rm "$IMAGE_TAG" || true; fi
                '''
            }
        }
    }
}
