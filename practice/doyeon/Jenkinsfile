def notifyDiscord(String status) {
  try {
    withCredentials([string(credentialsId: 'doyeon-discord-webhook', variable: 'DISCORD_WEBHOOK')]) {
      withEnv([
        "NOTIFY_STATUS=${status}",
        "NOTIFY_DURATION=${currentBuild.durationString.replace(' and counting', '')}"
      ]) {
        sh '''
          set +x
          python3 - <<'PY' | curl -sS -m 10 -H 'Content-Type: application/json' -d @- "$DISCORD_WEBHOOK" || true
import json, os
e = os.environ.get
lines = [
    "[doyeon] " + e("NOTIFY_STATUS", ""),
    "Job: " + e("JOB_NAME", "") + " #" + e("BUILD_NUMBER", ""),
    "모드: " + e("DEPLOY_MODE", "-") + " / 버전: " + e("APP_VERSION", "-") + " (release " + e("RELEASE_ID", "-") + ")",
    "소요 시간: " + e("NOTIFY_DURATION", ""),
    e("BUILD_URL", ""),
]
print(json.dumps({"content": "\\n".join(lines), "allowed_mentions": {"parse": []}}))
PY
        '''
      }
    }
  } catch (err) {
    echo "Discord notification skipped: ${err.class.simpleName}"
  }
}

pipeline {
  agent { label 'ansible-agent' }
  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timestamps()
  }
  parameters {
    string(name: 'APP_VERSION', defaultValue: 'v1', description: 'v1, v2 또는 장애 재현용 v3')
    choice(name: 'DEPLOY_MODE', choices: ['bootstrap', 'rolling', 'canary-rolling'], description: '첫 배포, 롤링 또는 카나리 후 롤링')
    choice(name: 'ROLLING_BATCH_SIZE', choices: ['1', '2'], description: '롤링 배포 시 동시에 교체할 앱 서버 수')
    choice(name: 'FAILURE_SCENARIO', choices: ['none', 'health', 'startup'], description: '장애 재현: Health Check 실패 또는 실행 실패')
  }
  environment {
    APP_VERSION = "${params.APP_VERSION}"
    DEPLOY_MODE = "${params.DEPLOY_MODE}"
    ROLLING_BATCH_SIZE = "${params.ROLLING_BATCH_SIZE ?: '1'}"
    FAILURE_SCENARIO = "${params.FAILURE_SCENARIO ?: 'none'}"
  }
  stages {
    stage('Build and validate') {
      steps {
        checkout scm
        script {
          if (!(params.APP_VERSION ==~ /^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$/)) {
            error('Invalid APP_VERSION')
          }
          env.RELEASE_ID = "${params.APP_VERSION}-${env.BUILD_NUMBER}"
          withCredentials([usernamePassword(
            credentialsId: 'doyeon-dockerhub',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_TOKEN'
          )]) {
            env.IMAGE_REF = "${env.DOCKER_USER}/doyeon-app:${env.RELEASE_ID}"
          }
        }
        dir('practice/doyeon/app') {
          sh 'python3 -m unittest test_main.py -v'
          sh '''
            docker build --build-arg APP_VERSION="$APP_VERSION" \
              --build-arg RELEASE_ID="$RELEASE_ID" \
              --build-arg FAILURE_SCENARIO="$FAILURE_SCENARIO" \
              -t "$IMAGE_REF" .
          '''
        }
        dir('practice/doyeon/ansible') {
          sh '''
            ansible-inventory --graph
            for playbook in bootstrap rolling canary-rolling start-canary verify-canary normalize-canary prepare-rollback rollback cleanup-rollback verify; do
              ansible-playbook "playbooks/$playbook.yml" --syntax-check
            done
          '''
        }
      }
    }
    stage('Push image') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'doyeon-dockerhub',
          usernameVariable: 'DOCKER_USER',
          passwordVariable: 'DOCKER_TOKEN'
        )]) {
          sh '''
            set +x
            export DOCKER_CONFIG="$WORKSPACE/.doyeon-docker-config"
            mkdir -p "$DOCKER_CONFIG"
            printf '%s' "$DOCKER_TOKEN" | docker login -u "$DOCKER_USER" --password-stdin
            docker push "$IMAGE_REF"
            docker logout
          '''
        }
      }
    }
    stage('Preserve healthy release') {
      when { expression { params.DEPLOY_MODE != 'bootstrap' } }
      steps {
        dir('practice/doyeon/ansible') {
          sshagent(credentials: ['doyeon-app-ssh']) {
            sh '''
              ansible-playbook playbooks/prepare-rollback.yml \
                -e "snapshot_path=$WORKSPACE/.doyeon-previous-release"
            '''
            script {
              def previous = readFile("${env.WORKSPACE}/.doyeon-previous-release").trim().split('\n')
              if (previous.size() != 2) { error('Invalid previous release snapshot') }
              env.PREVIOUS_VERSION = previous[0]
              env.PREVIOUS_RELEASE = previous[1]
            }
            script { env.ROLLBACK_READY = 'true' }
          }
        }
      }
    }
    stage('Deploy') {
      steps {
        dir('practice/doyeon/ansible') {
          sshagent(credentials: ['doyeon-app-ssh']) {
            sh '''
              set -e
              ansible-playbook "playbooks/$DEPLOY_MODE.yml" \
                -e "image_ref=$IMAGE_REF" -e "app_version=$APP_VERSION" \
                -e "release_id=$RELEASE_ID" -e "rolling_batch_size=$ROLLING_BATCH_SIZE" \
                -e "previous_version=${PREVIOUS_VERSION:-}" \
                -e "previous_release=${PREVIOUS_RELEASE:-}"
            '''
          }
        }
      }
    }
    stage('Verify all backends and Nginx') {
      steps {
        dir('practice/doyeon/ansible') {
          sshagent(credentials: ['doyeon-app-ssh']) {
            sh '''
              ansible-playbook playbooks/verify.yml \
                -e "app_version=$APP_VERSION" -e "release_id=$RELEASE_ID"
            '''
          }
        }
      }
    }
    stage('Clean up rollback images') {
      when { expression { env.ROLLBACK_READY == 'true' } }
      steps {
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          dir('practice/doyeon/ansible') {
            sshagent(credentials: ['doyeon-app-ssh']) {
              sh '''
                ansible-playbook playbooks/cleanup-rollback.yml -e "image_ref=$IMAGE_REF"
              '''
            }
          }
        }
      }
    }
  }
  post {
    always {
      sh '''
        if [ -n "${IMAGE_REF:-}" ]; then
          docker image rm "$IMAGE_REF" || true
        fi
        rm -rf "$WORKSPACE/.doyeon-docker-config"
        rm -f "$WORKSPACE/.doyeon-previous-release"
      '''
    }
    success { script { notifyDiscord('✅ 성공') } }
    failure {
      script {
        if (env.ROLLBACK_READY == 'true') {
          try {
            dir('practice/doyeon/ansible') {
              sshagent(credentials: ['doyeon-app-ssh']) {
                sh '''
                  ansible-playbook playbooks/rollback.yml \
                    -e "rollback_version=$PREVIOUS_VERSION" \
                    -e "rollback_release=$PREVIOUS_RELEASE"
                '''
              }
            }
            notifyDiscord('❌ 배포 실패 · 이전 정상 릴리스로 복구 완료')
          } catch (rollbackError) {
            echo "Automatic rollback failed: ${rollbackError}"
            notifyDiscord('🚨 배포 및 자동 롤백 실패 · 수동 확인 필요')
          }
        } else {
          notifyDiscord('❌ 실패')
        }
      }
    }
    aborted { script { notifyDiscord('⚠️ 중단') } }
  }
}
